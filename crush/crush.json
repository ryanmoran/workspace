{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "attribution": {
      "trailer_style": "none",
      "generated_with": false
    },
    "disable_metrics": true,
    "skills_paths": ["/skills", "./skills"]
  },
  "providers": {
    "Bifrost - Anthropic": {
      "type": "anthropic",
      "base_url": "https://bifrost.corp.hadrian.co/anthropic",
      "api_key": "$BIFROST_API_KEY",
      "models": [
        {
          "context_window": 1000000,
          "cost_per_1m_in": 3,
          "cost_per_1m_in_cached": 3.75,
          "cost_per_1m_out": 15,
          "cost_per_1m_out_cached": 0.3,
          "default_max_tokens": 128000,
          "id": "anthropic/claude-sonnet-4-6",
          "name": "Claude Sonnet 4.6",
          "can_reason": true,
          "reasoning_levels": ["max", "high", "medium", "low"],
          "default_reasoning_effort": "high",
          "supports_attachments": true
        },
        {
          "context_window": 1000000,
          "cost_per_1m_in": 5,
          "cost_per_1m_in_cached": 6.25,
          "cost_per_1m_out": 25,
          "cost_per_1m_out_cached": 0.5,
          "default_max_tokens": 128000,
          "id": "anthropic/claude-opus-4-8",
          "name": "Claude Opus 4.8",
          "can_reason": true,
          "reasoning_levels": ["max", "high", "medium", "low"],
          "default_reasoning_effort": "medium",
          "supports_attachments": true
        },
        {
          "context_window": 1000000,
          "cost_per_1m_in": 5,
          "cost_per_1m_in_cached": 6.25,
          "cost_per_1m_out": 25,
          "cost_per_1m_out_cached": 0.5,
          "default_max_tokens": 128000,
          "id": "anthropic/claude-opus-4-7",
          "name": "Claude Opus 4.7",
          "can_reason": true,
          "reasoning_levels": ["max", "high", "medium", "low"],
          "default_reasoning_effort": "medium",
          "supports_attachments": true
        }
      ]
    },
    "Bifrost - OpenAI": {
      "type": "openai",
      "base_url": "https://bifrost.corp.hadrian.co/openai",
      "api_key": "$BIFROST_API_KEY",
      "models": [
        {
          "context_window": 1000000,
          "cost_per_1m_in": 5,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 30,
          "cost_per_1m_out_cached": 0.5,
          "default_max_tokens": 128000,
          "id": "openai/gpt-5.5",
          "name": "Gpt 5.5"
        },
        {
          "context_window": 1000000,
          "cost_per_1m_in": 2.5,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 15,
          "cost_per_1m_out_cached": 0.25,
          "default_max_tokens": 128000,
          "id": "openai/gpt-5.4",
          "name": "Gpt 5.4"
        }
      ]
    }
  },
  "lsp": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"]
    }
  },
  "mcp": {
    "datadog": {
      "disabled": true,
      "type": "http",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "headers": {
        "DD_API_KEY": "$DD_API_KEY",
        "DD_APPLICATION_KEY": "$DD_APPLICATION_KEY"
      }
    },
    "github": {
      "disabled": true,
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "timeout": 120,
      "disabled_tools": [
        "actions_run_trigger",
        "assign_copilot_to_issue",
        "create_branch",
        "create_gist",
        "create_or_update_file",
        "create_pull_request",
        "create_pull_request_with_copilot",
        "create_repository",
        "delete_file",
        "discussion_comment_write",
        "dismiss_notification",
        "fork_repository",
        "issue_write",
        "label_write",
        "manage_notification_subscription",
        "manage_repository_notification_subscription",
        "mark_all_notifications_read",
        "merge_pull_request",
        "projects_write",
        "pull_request_review_write",
        "push_files",
        "request_copilot_review",
        "star_repository",
        "sub_issue_write",
        "unstar_repository",
        "update_gist",
        "update_pull_request",
        "update_pull_request_branch"
      ]
    },
    "playwright": {
      "disabled": true,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--caps=devtools,testing,network"
      ]
    }
  }
}
